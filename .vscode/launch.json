{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Water Sim",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/bin/water.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        {
          "name": "PATH",
          "value": "${workspaceFolder}/bin;${env:PATH}"
        }
      ],
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/libraries/mingw64/bin/gdb.exe",
