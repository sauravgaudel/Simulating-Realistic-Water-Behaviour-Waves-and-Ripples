        }
      ],
      "preLaunchTask": "Build Water Sim"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/Users/User/3sem/Graphics/lab/water-sim/src",
      "program": "c:/Users/User/3sem/Graphics/lab/water-sim/src/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
